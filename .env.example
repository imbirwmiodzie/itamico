# Postgres connection string (Supabase or Neon free tier).
# Supabase: use the pooler URL; if TLS verification fails append ?sslmode=no-verify
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require
# Long random secret, e.g. `openssl rand -hex 24`. Also part of the connector URL.
MCP_TOKEN=
# User's time zone: decides what "due today" means.
TUTOR_TZ=Europe/Warsaw
PORT=8080
