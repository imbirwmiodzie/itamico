# Copy to deploy/deploy.env (git-ignored) and fill in. Used by deploy/deploy.sh.
SSH_TARGET=user@your-server
SSH_PORT=22
# SSH_KEY=~/Downloads/ssh-key.key   # same as ssh -i
# REMOTE_DIR=itamico

# Passed to deploy/install.sh on the server
DOMAIN=tutor.yourdomain.com
HTTPS_PORT=28443
# BEHIND_CLOUDFLARE=1   # domain proxied by Cloudflare: self-signed cert on the server, no port 80
# PLAIN_HTTP=1   # no certificate: plain http on HTTPS_PORT (testing only; Claude needs https)
TUTOR_TZ=Europe/Warsaw
# DATABASE_URL=postgres://...   # omit to use Postgres on the server
